   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 生成一些测试数据（随机正态分布）\n",
    "v = np.random.randn(1000)\n",
    "\n",
    "# 计算直方图\n",
    "(n, bins) = np.histogram(v, bins=50, density=True)\n",
    "\n",
    "# 计算中心点并画图\n",
    "plt.plot(.5*(bins[1:]+bins[:-1]), n)\n",
    "plt.title(\"My First Matplotlib Plot\") # 加个标题\n",
    "plt.show()"
   ]
  }
 ],
